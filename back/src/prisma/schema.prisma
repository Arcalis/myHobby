generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String      @id(map: "User_pkey") @default(uuid())
  name         String?
  first_name   String?
  second_name  String?
  email        String      @unique(map: "User_email_key")
  password     String
  organizer_id String?
  role         String      @default("user")
  complaint    Complaint[]
  user_event   UserEvent[]
  organizer    Organizer?  @relation(fields: [organizer_id], references: [id], map: "User_organizer_id_fkey")

  @@map("users")
}

model Complaint {
  id         String   @id @default(uuid()) @map("id")
  from_user  String   @map("from_user")
  message    String   @map("message")
  created_at DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [from_user], references: [id])

  @@map("complaints")
}

model Organizer {
  id    String  @id @default(uuid()) @map("id")
  name  String  @map("name")
  event Event[]
  users User[]

  @@map("organizers")
}

model Age {
  id           String  @id @default(uuid()) @map("id")
  age_category String  @map("age_category")
  event        Event[]

  @@map("ages")
}

model Tag {
  id    String  @id @default(uuid()) @map("id")
  tag   String  @unique @map("tag")
  event Event[]

  @@map("tags")
}

model Event {
  id            String      @id @default(uuid()) @map("id")
  name          String      @map("name")
  is_reccuring  Boolean?    @default(false) @map("is_reccuring")
  format        String      @map("format")
  desription    String?     @map("desription")
  created       DateTime?   @default(now()) @map("created")
  date          DateTime?   @map("date")
  time          String?     @map("time")
  count_members Int?        @map("count_members")
  address       String?     @map("address")
  author        String?     @map("author")
  tag_id        String?     @map("tag_id")
  age_id        String?     @map("age_id")
  organizer_id  String?     @map("organizer_id")
  approved      Boolean?    @default(false) @map("approved")
  active        Boolean?    @default(true) @map("active")
  deleted       Boolean?    @default(false) @map("deleted")
  age           Age?        @relation(fields: [age_id], references: [id])
  organizer     Organizer?  @relation(fields: [organizer_id], references: [id])
  tag           Tag?        @relation(fields: [tag_id], references: [id])
  user_event    UserEvent[]

  @@map("events")
}

model UserEvent {
  id        String   @id @default(uuid()) @map("id")
  id_user   String   @map("id_user")
  id_event  String   @map("id_event")
  favorites Boolean? @default(false) @map("favorites")
  member    Boolean? @default(false) @map("member")
  event     Event    @relation(fields: [id_event], references: [id])
  user      User     @relation(fields: [id_user], references: [id])

  @@unique([id_user, id_event])
  @@map("user_event")
}
