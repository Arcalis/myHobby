generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int         @id @default(autoincrement())
  name         String?     
  first_name   String?
  second_name  String?
  email        String      @unique
  password     String
  organizer_id Int?
  role         String      @default("user")
  blocked      Boolean?    @default(false)
  complaint    Complaint[]
  user_event   UserEvent[]
  organizer    Organizer?  @relation(fields: [organizer_id], references: [id])

  @@map("users")
}

model Complaint {
  id         Int      @id @default(autoincrement())
  from_user  Int
  message    String
  created_at DateTime @default(now())
  user       User     @relation(fields: [from_user], references: [id])

  @@map("complaints")
}

model Organizer {
  id    Int     @id @default(autoincrement())
  name  String  @unique
  event Event[]
  users User[]

  @@map("organizers")
}

model Age {
  id           Int     @id @default(autoincrement())
  age_category String
  event        Event[]

  @@map("ages")
}

model Tag {
  id    Int     @id @default(autoincrement())
  tag   String  @unique
  event Event[]

  @@map("tags")
}

model Event {
  id            Int         @id @default(autoincrement())
  name          String @unique
  is_reccuring  Boolean?    @default(false)
  format        String
  desription    String?
  created       DateTime?   @default(now())
  date          DateTime?   @db.Date
  time          String?
  count_members Int?
  address       String?
  author        Int?
  tag_id        Int?
  age_id        Int?
  organizer_id  Int?
  approved      Boolean?    @default(false)
  active        Boolean?    @default(true)
  deleted       Boolean?    @default(false)
  age           Age?        @relation(fields: [age_id], references: [id])
  organizer     Organizer?  @relation(fields: [organizer_id], references: [id])
  tag           Tag?        @relation(fields: [tag_id], references: [id])
  user_event    UserEvent[]

  @@map("events")
}

model UserEvent {
  id        Int      @id @default(autoincrement())
  id_user   Int
  id_event  Int
  favorites Boolean? @default(false)
  member    Boolean? @default(false)
  event     Event    @relation(fields: [id_event], references: [id])
  user      User     @relation(fields: [id_user], references: [id])

  @@unique([id_user, id_event])
  @@map("user_event")
}